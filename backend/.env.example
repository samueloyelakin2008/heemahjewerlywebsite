# ====================================================================
# HEEMAH JEWELRY — .env.example
# Copy this file to .env (gitignored) and fill in real values.
# THIS file is safe to commit — it contains NO real secrets.
# ====================================================================

# --- Server ---------------------------------------------------------
PORT=5000
NODE_ENV=production

# Your live domain (Railway auto-assigns one, swap for custom domain later)
FRONTEND_BASE_URL=https://YOUR-RAILWAY-DOMAIN.up.railway.app

# Comma-separated extra origins. Leave blank if frontend is served by
# this same Express server (the normal setup).
ALLOWED_ORIGINS=

# --- Paystack -------------------------------------------------------
# Get from: https://dashboard.paystack.com/#/settings/developer
# Use sk_test_* / pk_test_* for testing, sk_live_* / pk_live_* for real money
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Firebase Admin SDK (server-side only — NEVER expose this) ------
# How to generate this value:
#   1. Firebase Console → Project Settings → Service Accounts
#   2. Click "Generate new private key" → download the .json file
#   3. Run this command to turn it into one line:
#        node -e "const fs=require('fs'); process.stdout.write(JSON.stringify(JSON.parse(fs.readFileSync('firebaseserviceaccount.json','utf8'))))"
#   4. Paste the output here (starts with {"type":"service_account",...})
#   The .json file itself must NEVER be committed to git.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@YOUR_PROJECT_ID.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}

# --- Google Apps Script (sales logging to Google Sheets) -----------
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_SCRIPT_SHARED_SECRET=replace-with-random-secret

# --- Admin ----------------------------------------------------------
ADMIN_EMAIL=your@email.com
ADMIN_EMAILS=your@email.com

# --- Cloudinary (product image storage) ----------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=heemah-jewelry/products

# --- Outgoing email (receipts) -------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
# Gmail: use an App Password (not your login password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM_NAME=Heemah Jewelry

# --- WhatsApp admin notifications ----------------------------------
# Leave blank to skip — the app degrades gracefully without this
WHATSAPP_API_URL=https://graph.facebook.com/v20.0/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_TOKEN=your-permanent-access-token
WHATSAPP_ADMIN_NUMBER=2348100000000

# --- Rate limiting --------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=10
RATE_LIMIT_MAX_REQUESTS=100
